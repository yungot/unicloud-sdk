# 复制为 .env.local 并填好后再跑 examples/quickstart.mjs
# 这些值来自 HBuilderX 关联 uniCloud 服务空间时的客户端配置，不要提交到 git

UNICLOUD_PROVIDER=alipay
UNICLOUD_SPACE_ID=env-xxxxxxxx
UNICLOUD_SPACE_APP_ID=
UNICLOUD_ACCESS_KEY=
UNICLOUD_SECRET_KEY=
UNICLOUD_APP_ID=__UNI__YOUR_APP

# 可选
# UNICLOUD_ENDPOINT=
# UNICLOUD_DEVICE_ID=
# UNICLOUD_CLIENT_SECRET=   # 仅阿里云空间需要
